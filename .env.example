# Copy to .env on the Unraid host (never commit .env)

# Friendly name in Cursor → My Machines picker
WORKER_NAME=unraid

# Personal user API key (Dashboard → API Keys). Not a team/service account key.
CURSOR_API_KEY=

# Optional: clone this remote into the repo volume on first start
REPO_URL=https://github.com/gavinlc/ai-job-search.git
REPO_BRANCH=master

# Host paths (Unraid examples)
REPO_HOST_PATH=/mnt/user/appdata/cursor-worker/repo
CONFIG_HOST_PATH=/mnt/user/appdata/cursor-worker/config

# Keep worker connected when idle (0 = never idle-exit)
IDLE_RELEASE_TIMEOUT=0

# Optional corporate proxy
# HTTPS_PROXY=http://proxy.example:8080
